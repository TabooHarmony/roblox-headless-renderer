    </Item>
    <Item class="TextLabel" referent="RBX8">
      <Properties>
        <string name="Name">WideFont</string>
        <UDim2 name="Position"><XS>0</XS><XO>20</XO><YS>0</YS><YO>320</YO></UDim2>
        <UDim2 name="Size"><XS>0</XS><XO>230</XO><YS>0</YS><YO>40</YO></UDim2>
        <float name="BackgroundTransparency">0</float>
        <Color3 name="BackgroundColor3"><R>0.2</R><G>0.2</G><B>0.2</B></Color3>
        <string name="Text">LEADERBOARD</string>
        <Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3>
        <Font name="FontFace"><Family><url>rbxasset://fonts/families/LuckiestGuy.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font>
        <float name="TextSize">36</float>
        <bool name="TextWrapped">false</bool>
      </Properties>
    </Item>
  </Item>
</roblox>
