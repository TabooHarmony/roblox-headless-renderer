#!/bin/sh
set -e
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "$RHR_MCP_PYTHON" ]; then
  candidates="$RHR_MCP_PYTHON"
else
  candidates="$(command -v python3 2>/dev/null || true) /usr/local/bin/python3 /usr/bin/python3"
fi

for python in $candidates; do
  [ -x "$python" ] || continue
  if "$python" -c 'import mcp.server.fastmcp' >/dev/null 2>&1; then
    exec "$python" "$repo/scripts/rhr_mcp.py" "$@"
  fi
done

echo "rhr-mcp: no host Python with the MCP SDK found; set RHR_MCP_PYTHON" >&2
exit 2
