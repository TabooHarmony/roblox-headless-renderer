--- a/web_demo/rbxm_parser_component/tree_to_pinevexobject.py
+++ b/web_demo/rbxm_parser_component/tree_to_pinevexobject.py
@@ -381,6 +381,14 @@
     if name:
         result["name"] = name
 
+    # Carry the caller's path label through. The renderer stores every resolved
+    # rect under `_path` when it is handed a rect_map (render_json(rect_map=...)),
+    # which is how a caller reads the layout back without re-deriving it. Absent
+    # for callers that do not label their nodes.
+    path = raw.get("_path")
+    if path:
+        result["_path"] = path
