+def _render_children_only(canvas: skia.Canvas, node: dict, rect: Rect, ctx: dict) -> None:
+    """Lay out and draw a node's children without drawing the node itself.
+
+    Used for zero-area nodes, which paint nothing of their own but still lay
+    their children out against the (zero) rect, the same way Roblox does.
+    """
+    children = node.get("children", [])
+    if not children:
+        return
+
+    pad_top, pad_bottom, pad_left, pad_right = _resolve_padding(node.get("padding", {}), rect.w, rect.h)
+    content_rect = Rect(
+        rect.x + pad_left,
+        rect.y + pad_top,
+        max(0.0, rect.w - pad_left - pad_right),
+        max(0.0, rect.h - pad_top - pad_bottom),
+    )
+
+    children_ordered = sorted(children, key=lambda c: c.get("layoutOrder", 0))
+    list_layout = node.get("list")
+    grid_layout = node.get("grid")
+    if list_layout:
+        _render_list_children(canvas, children_ordered, content_rect, list_layout, ctx,
+                              size_ref_rect=content_rect)
+    elif grid_layout:
+        _render_grid_children(canvas, children_ordered, content_rect, grid_layout, ctx,
+                              size_ref_rect=content_rect)
+    else:
+        for child in sorted(children, key=lambda c: c.get("zIndex", 1)):
+            render_node(canvas, child, content_rect, ctx)
+
+
