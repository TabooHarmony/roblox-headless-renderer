     return float(default)
 
 
+def _grid_axis(spec, ref_dim: float, axis: int, default: float) -> float:
+    """One axis of a UIGridLayout CellSize/CellPadding, in pixels.
+
+    The spec is [xScale, yScale], or [xScale, xOffset, yScale, yOffset] when an
+    offset is non-zero. Offsets are pixels and must not be dropped: a CellSize of
+    (0, 32, 0, 32) is the most common grid in real UI, and reading only the scale
+    slot makes it zero, which renders the grid blank.
+    """
+    if not isinstance(spec, (list, tuple)):
+        return float(default) * ref_dim
+    if len(spec) >= 4:
+        return _num(spec[axis * 2], 0.0) * ref_dim + _num(spec[axis * 2 + 1], 0.0)
+    return _seq_num(spec, axis, default) * ref_dim
+
+
