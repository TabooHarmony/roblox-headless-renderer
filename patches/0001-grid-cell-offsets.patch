# UIGridLayout CellSize/CellPadding offsets are kept and read
#
# Apply from vendor/pinevex:  git apply -p1 < patches/0001-grid-cell-offsets.patch
--- a/src/ui_engine/renderer.py
+++ b/src/ui_engine/renderer.py
