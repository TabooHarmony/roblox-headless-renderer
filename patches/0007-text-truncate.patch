# TextTruncate (AtEnd/SplitWord) passes through and draws with an ellipsis; its unwrapped-line hunk also carries unwrapped explicit newlines and the converter carries LineHeight
#
# Apply from vendor/pinevex:  git apply -p1 < patches/0007-text-truncate.patch
--- a/src/ui_engine/text_renderers.py
+++ b/src/ui_engine/text_renderers.py
@@ -1,4 +1,50 @@
 from .text_rich import *
+from .text_advances import (
+    load_advance_table,
+    has_full_ascii as _table_covers_text,
+    string_width as _string_width,
+    draw_line_table,
+)
+
+
+def _truncate_ellipsis(text: str, font: skia.Font, max_width: float,
+                       emoji_font=None, fallback_fonts=(), split_word: bool = False) -> str:
+    """Trim text so it plus an ellipsis fits max_width, per TextTruncate mode.
+
+    AtEnd cuts at whatever character boundary fits; SplitWord backs up to the
+    last word boundary inside that. The star points are measured with the
+    same mixed-run measurement drawing uses, so the cut is where the engine
+    itself would stop, not a char count. Exact ellipsis placement parity with
+    Studio is a ground-truth question this does not guess at.
+    """
+    if not text:
+        return text
+    ellipsis = "…"
+
+    def width(s: str) -> float:
+        return _measure_mixed(s, font, emoji_font, fallback_fonts)
+
+    if width(text + ellipsis) <= max_width:
+        return text + ellipsis
+    # Binary search the longest prefix that fits with the ellipsis appended.
+    lo, hi = 0, len(text)
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if width(text[:mid] + ellipsis) <= max_width:
+            lo = mid
+        else:
+            hi = mid - 1
+    cut = text[:lo]
+    if split_word and cut and not cut[-1].isspace():
+        # Back up to the last word boundary, if one leaves something.
+        stripped = cut.rstrip()
+        last_break = max(stripped.rfind(" "), stripped.rfind("\t"))
+        if last_break > 0:
+            cut = stripped[: last_break + 1]
+    trimmed = cut.rstrip() + ellipsis
+    # A single grapheme plus ellipsis can still overflow a tiny box; the
+    # ellipsis itself is then the whole output, never an empty string.
+    return trimmed if width(trimmed) <= max_width or lo == 0 else ellipsis
 
 
